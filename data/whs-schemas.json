  {
    "id": "T15",
    "version": "1",
    "title": "WHS Workplace Inspection",
    "description": "Periodic workplace inspection to identify and address WHS hazards.",
    "stage": "operational",
    "permissions": {
      "canFill": ["agronomist"],
      "canSign": ["agronomist"],
      "canView": ["owner", "manager"]
    },
    "sections": [
      {
        "title": "Inspection Details",
        "fields": [
          {
            "key": "inspection_date",
            "label": "Inspection Date",
            "type": "date",
            "required": true
          },
          {
            "key": "area_inspected",
            "label": "Area(s) Inspected",
            "type": "text",
            "required": true
          },
          {
            "key": "inspector",
            "label": "Inspector Name",
            "type": "text",
            "required": true
          },
          {
            "key": "worker_rep",
            "label": "Worker Representative (if applicable)",
            "type": "text"
          }
        ]
      },
      {
        "title": "Inspection Checklist",
        "fields": [
          {
            "key": "inspection_items",
            "label": "Inspection Items",
            "type": "checklist",
            "responseType": "tri_state",
            "items": [
              "Housekeeping and general tidiness",
              "Emergency exits clear and signage visible",
              "Fire extinguishers in place and in date",
              "First aid kit stocked and accessible",
              "Chemical storage compliant with SDS requirements",
              "Plant and equipment guarding in place",
              "Electrical safety — no damaged cords or exposed wiring",
              "Slips, trips and falls hazards addressed",
              "Personal protective equipment available and used",
              "WHS notices and signs up to date",
              "Waste disposal appropriate",
              "Lighting adequate for tasks performed"
            ],
            "required": true
          }
        ]
      },
      {
        "title": "Findings & Actions",
        "fields": [
          {
            "key": "issues",
            "label": "Issues Identified & Actions Required",
            "type": "table",
            "columns": [
              { "key": "issue", "label": "Issue", "type": "text" },
              { "key": "risk", "label": "Risk Level", "type": "select", "options": ["Low", "Medium", "High", "Extreme"] },
              { "key": "action", "label": "Action Required", "type": "text" },
              { "key": "responsible", "label": "Responsible", "type": "text" },
              { "key": "due", "label": "Due Date", "type": "date" },
              { "key": "completed", "label": "Completed", "type": "yes_no" }
            ]
          },
          {
            "key": "overall_rating",
            "label": "Overall Workplace Safety Rating",
            "type": "select",
            "options": ["Satisfactory", "Requires Improvement", "Unsatisfactory"],
            "required": true
          },
          {
            "key": "signature",
            "label": "Inspector Signature",
            "type": "signature",
            "required": true
          }
        ]
      }
    ]
  }
]
