          {
            "key": "manager_signature",
            "label": "Manager Signature",
            "type": "signature",
            "required": true
          }
        ]
      }
    ]
  },
  {
    "id": "T11",
    "version": "1",
    "title": "Safe Work Method Statement (SWMS)",
    "description": "Step-by-step safety procedures for high risk construction or farm work.",
    "stage": "operational",
    "permissions": {
      "canFill": ["manager"],
      "canSign": ["manager"],
      "canView": ["owner", "manager", "agronomist", "staff"]
    },
    "sections": [
      {
        "title": "Task Overview",
        "fields": [
          {
            "key": "task_name",
            "label": "Task / Activity",
            "type": "text",
            "required": true
          },
          {
            "key": "task_location",
            "label": "Location",
            "type": "text",
            "required": true
          },
          {
            "key": "date",
            "label": "Date",
            "type": "date",
            "required": true
          },
          {
            "key": "prepared_by",
            "label": "Prepared By",
            "type": "text",
            "required": true
          }
        ]
      },
      {
        "title": "Work Steps & Controls",
        "fields": [
          {
            "key": "steps",
            "label": "Work Steps",
            "type": "table",
            "columns": [
              { "key": "step", "label": "Step", "type": "number" },
              { "key": "description", "label": "Work Step Description", "type": "text" },
              { "key": "hazards", "label": "Hazards", "type": "text" },
              { "key": "controls", "label": "Control Measures", "type": "text" },
              { "key": "ppe", "label": "PPE Required", "type": "text" }
            ],
            "required": true
          }
        ]
      },
      {
        "title": "Worker Acknowledgement",
        "fields": [
          {
            "key": "workers_signed",
            "label": "Workers who have read and understood this SWMS",
            "type": "table",
            "columns": [
              { "key": "name", "label": "Name", "type": "text" },
              { "key": "date", "label": "Date", "type": "date" }
            ]
          },
          {
            "key": "supervisor_signature",
            "label": "Supervisor Signature",
            "type": "signature",
            "required": true
          }
        ]
      }
    ]
  },
  {
    "id": "T12",
    "version": "1",
    "title": "Plant & Equipment Pre-Start Checklist",
    "description": "Daily pre-operational safety check for farm plant and equipment.",
    "stage": "operational",
    "permissions": {
      "canFill": ["manager"],
      "canSign": ["manager"],
      "canView": ["owner", "manager"]
    },
    "sections": [
      {
        "title": "Equipment Details",
        "fields": [
          {
            "key": "equipment_name",
            "label": "Plant / Equipment Name",
            "type": "text",
            "required": true
          },
          {
            "key": "registration",
            "label": "Registration / ID",
            "type": "text"
          },
          {
            "key": "check_date",
            "label": "Date",
            "type": "date",
            "required": true
          },
          {
            "key": "operator",
            "label": "Operator Name",
            "type": "text",
            "required": true
          }
        ]
      },
      {
        "title": "Pre-Start Checks",
        "fields": [
          {
            "key": "checks",
            "label": "Check Items",
            "type": "checklist",
            "responseType": "tri_state",
            "items": [
              "Engine oil level",
              "Coolant level",
              "Hydraulic fluid level",
              "Fuel level",
              "Tyre condition and pressure",
              "Lights and indicators",
              "Brakes operational",
              "Seatbelt / ROPS present and functional",
              "Mirrors and visibility clear",
              "All guards in place",
              "No visible fluid leaks",
              "Horn operational",
              "Fire extinguisher present and in date"
            ],
            "required": true
          },
          {
