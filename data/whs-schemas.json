            "type": "text",
            "required": true
          },
          {
            "key": "injury_date",
            "label": "Date of Injury / Illness",
            "type": "date",
            "required": true
          },
          {
            "key": "injury_description",
            "label": "Nature of Injury / Illness",
            "type": "textarea",
            "required": true
          },
          {
            "key": "treating_doctor",
            "label": "Treating Medical Practitioner",
            "type": "text"
          },
          {
            "key": "claim_number",
            "label": "Workers' Compensation Claim Number",
            "type": "text"
          }
        ]
      },
      {
        "title": "Return to Work Schedule",
        "fields": [
          {
            "key": "return_date",
